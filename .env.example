# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to .env or inject these variables in your target environment.
# ==============================================================================

# Active Spring Profile (dev, qa, stg, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port (default: 8080)
SERVER_PORT=8080

# MongoDB Connection URI
# Dev default: mongodb://localhost:27017/taskmanager_dev
# Production format: mongodb://<user>:<password>@<host>:<port>/<database>?authSource=admin&replicaSet=<rs>&ssl=true
MONGODB_URI=mongodb://localhost:27017/taskmanager_dev

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 characters)
JWT_SECRET=dnbTaskManagementSecureJwtSecretKeyMustBeAtLeast256BitsLongForHmacSha256SecurityRequirement

# JWT Token Expiration in Milliseconds (e.g., 86400000 = 24 hours, 14400000 = 4 hours)
JWT_EXPIRATION_MS=86400000

# Allowed CORS Origins (comma-separated list for web applications)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# JVM Options (container memory limits, garbage collection)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

